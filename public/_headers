# Cloudflare Pages / Netlify headers (copied into dist/ by Vite).
# The app shell and the service worker must always revalidate so an update is picked up on the next load;
# hashed build assets never change, so they can be cached for a year.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
